# Local profile cache (never commit per-user state)
.chameleon/drift.db
.chameleon/.skip
.chameleon/.tmp/
.chameleon/.lock

# Local env (test repo paths, etc.)
.env

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node
node_modules/
*.log

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*~

# Build artifacts
dist/
build/

# Test coverage
.coverage
htmlcov/
coverage.xml

# Local Claude Code state (worktrees, session caches, agent transcripts).
# The exceptions are the authored, committed surfaces: rule files that lazy-load
# by path, and the /loop audit command with the agent and skill it dispatches.
# .claude/loop/ stays ignored -- that is per-run output, not source.
.claude/*
!.claude/rules/
!.claude/commands/
!.claude/agents/
!.claude/skills/

# Journey harness run output (per-run ephemeral dirs)
tests/journey/results/

# Effectiveness eval run output (per-run ephemeral dirs)
tests/effectiveness/results/
# Dogfood study PR-comment cache (network-fetched, re-derivable)
tests/effectiveness/.study_cache/
# Pytest cache for harness library tests
tests/journey/harness/tests/__pycache__/
tests/journey/harness/tests/.pytest_cache/
docs/superpowers/
.in_use/

# Local QA scratch + Ruby LSP index
.qa_scratch/
.ruby-lsp/
